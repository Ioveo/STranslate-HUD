<UserControl
    x:Class="STranslate.Plugin.Translate.OpenAI.View.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
    xmlns:local="clr-namespace:STranslate.Plugin.Translate.OpenAI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:plugin="clr-namespace:STranslate.Plugin;assembly=STranslate.Plugin"
    xmlns:s="https://github.com/zggsong/2022/xaml"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:vm="clr-namespace:STranslate.Plugin.Translate.OpenAI.ViewModel"
    d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <ikw:SimpleStackPanel Spacing="12">
        <!--  服务商快捷预设  -->
        <ui:SettingsCard Description="一键填充常见大模型服务商的官方接口地址与推荐模型列表" Header="常用服务商预设">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Sparkle_24_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <WrapPanel Orientation="Horizontal">
                <Button
                    Margin="0,0,6,4"
                    Command="{Binding ApplyPresetCommand}"
                    CommandParameter="DeepSeek"
                    Content="DeepSeek" />
                <Button
                    Margin="0,0,6,4"
                    Command="{Binding ApplyPresetCommand}"
                    CommandParameter="SiliconFlow"
                    Content="硅基流动" />
                <Button
                    Margin="0,0,6,4"
                    Command="{Binding ApplyPresetCommand}"
                    CommandParameter="Ollama"
                    Content="Ollama (本地)" />
                <Button
                    Margin="0,0,6,4"
                    Command="{Binding ApplyPresetCommand}"
                    CommandParameter="OpenAI"
                    Content="OpenAI" />
                <Button
                    Margin="0,0,6,4"
                    Command="{Binding ApplyPresetCommand}"
                    CommandParameter="DashScope"
                    Content="通义千问" />
                <Button
                    Margin="0,0,6,4"
                    Command="{Binding ApplyPresetCommand}"
                    CommandParameter="Moonshot"
                    Content="Kimi" />
            </WrapPanel>
        </ui:SettingsCard>

        <!--  API 模式配置  -->
        <ui:SettingsCard Description="{DynamicResource STranslate_Plugin_Translate_OpenAI_ApiMode_Description}" Header="{DynamicResource STranslate_Plugin_Translate_OpenAI_ApiMode}">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.ArrowSwap_20_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <ComboBox
                MinWidth="200"
                SelectedValue="{Binding ApiMode}"
                SelectedValuePath="Tag">
                <ComboBoxItem Content="{DynamicResource STranslate_Plugin_Translate_OpenAI_ApiMode_ChatCompletions}" Tag="{x:Static local:OpenAIApiMode.ChatCompletions}" />
                <ComboBoxItem Content="{DynamicResource STranslate_Plugin_Translate_OpenAI_ApiMode_Responses}" Tag="{x:Static local:OpenAIApiMode.Responses}" />
            </ComboBox>
        </ui:SettingsCard>

        <!--  API URL 配置  -->
        <ui:SettingsCard Description="{DynamicResource Url_Description}" Header="{DynamicResource Url}">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Globe_24_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <ikw:SimpleStackPanel Orientation="Vertical" Spacing="8">
                <TextBox
                    x:Name="PART_UrlTb"
                    MinWidth="300"
                    ui:ControlHelper.PlaceholderText="https://api.openai.com"
                    Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock
                    FontSize="{DynamicResource STControlFontSize12}"
                    Foreground="{DynamicResource {x:Static ui:ThemeKeys.SystemFillColorNeutralBrushKey}}"
                    Text="{Binding FinalUrl}"
                    ToolTip="{DynamicResource Url_ToolTip}" />
            </ikw:SimpleStackPanel>
        </ui:SettingsCard>

        <!--  API Key 配置  -->
        <ui:SettingsCard Description="{DynamicResource ApiKey_Suggestion}" Header="{DynamicResource ApiKey}">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Key_24_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <PasswordBox
                MinWidth="300"
                plugin:PasswordBoxAssistant.Attach="True"
                plugin:PasswordBoxAssistant.Password="{Binding ApiKey}"
                ui:ControlHelper.PlaceholderText="{DynamicResource ApiKey_Suggestion}" />
        </ui:SettingsCard>

        <!--  Model 配置  -->
        <ui:SettingsCard Header="{DynamicResource Model}">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon FontFamily="{StaticResource {x:Static ui:ThemeKeys.FluentSystemIconsKey}}" Glyph="&#xF0797;" />
            </ui:SettingsCard.HeaderIcon>
            <ComboBox
                MinWidth="200"
                IsEditable="True"
                ItemsSource="{Binding Models}"
                SelectedItem="{Binding Model, Mode=TwoWay}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="LostFocus">
                        <i:InvokeCommandAction Command="{Binding AddModelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ComboBox}, Path=Text}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Text="{Binding}" />
                            <Button
                                Grid.Column="1"
                                Margin="4,0,0,0"
                                Padding="4"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding DataContext.DeleteModelCommand, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                CommandParameter="{Binding}">
                                <ui:FontIcon
                                    FontSize="{DynamicResource STControlFontSize12}"
                                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                    Icon="{x:Static ui:FluentSystemIcons.Delete_24_Regular}" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </ui:SettingsCard>

        <!--  提示词选择和编辑  -->
        <ui:SettingsCard Description="{DynamicResource Prompt_Description}" Header="{DynamicResource Prompt_Header}">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Chat_20_Regular}" />
            </ui:SettingsCard.HeaderIcon>

            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox
                    MinWidth="200"
                    ui:ControlHelper.PlaceholderText="{DynamicResource Prompt_Placeholder}"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding Main.Prompts}"
                    SelectedItem="{Binding Main.SelectedPrompt, Mode=TwoWay}" />

                <Button Command="{Binding EditPromptCommand}" ToolTip="{DynamicResource EditPrompt_ToolTip}">
                    <ui:IconAndText Content="{DynamicResource EditPrompt_Content}" Icon="{x:Static ui:FluentSystemIcons.Edit_24_Regular}" />
                </Button>
            </ikw:SimpleStackPanel>
        </ui:SettingsCard>

        <!--  温度控制  -->
        <ui:SettingsCard Description="{DynamicResource Temperature_Description}" Header="{DynamicResource Temperature}">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Temperature_20_Regular}" />
            </ui:SettingsCard.HeaderIcon>

            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                <Slider
                    x:Name="PART_TempSlider"
                    MinWidth="200"
                    IsSnapToTickEnabled="True"
                    Maximum="2.0"
                    Minimum="0.0"
                    TickFrequency="0.1"
                    TickPlacement="Both"
                    Value="{Binding Temperature}" />

                <TextBlock VerticalAlignment="Center" Text="{Binding ElementName=PART_TempSlider, Path=Value, StringFormat=F1}" />
            </ikw:SimpleStackPanel>
        </ui:SettingsCard>

        <!--  附加请求参数  -->
        <ui:SettingsCard
            Description="{DynamicResource STranslate_Plugin_Translate_OpenAI_AdditionalParameters_Description}"
            Header="{DynamicResource STranslate_Plugin_Translate_OpenAI_AdditionalParameters}">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Code_20_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <TextBox
                MinWidth="300"
                MinHeight="80"
                AcceptsReturn="True"
                FontFamily="Consolas"
                Text="{Binding AdditionalParametersJson, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap"
                ui:ControlHelper.PlaceholderText="{}{&quot;thinking&quot;: {&quot;type&quot;: &quot;enabled&quot;}}"
                VerticalScrollBarVisibility="Auto" />
        </ui:SettingsCard>


        <!--  连接验证  -->
        <ui:SettingsCard Description="{DynamicResource PluginTranslateValidateDescription}" Header="{DynamicResource PluginTranslateValidate}">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.CheckmarkCircle_24_Regular}" />
            </ui:SettingsCard.HeaderIcon>

            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="12">
                <Button Command="{Binding ValidateCommand}" Style="{StaticResource AccentButtonStyle}">
                    <ui:IconAndText Content="{DynamicResource PluginTranslateValidate}" Icon="{x:Static ui:FluentSystemIcons.Play_24_Regular}" />
                </Button>

                <!--  验证结果显示  -->
                <Border>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4" />
                            <Setter Property="Padding" Value="8,4" />
                            <Setter Property="Background" Value="{DynamicResource {x:Static ui:ThemeKeys.SystemFillColorAttentionBackgroundBrushKey}}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ValidateResult}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="{DynamicResource STControlFontSize12}"
                        Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                        Text="{Binding ValidateResult}" />
                </Border>
            </ikw:SimpleStackPanel>
        </ui:SettingsCard>
    </ikw:SimpleStackPanel>
</UserControl>
